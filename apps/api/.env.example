# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env

# Server
PORT=3000

# Storage (local | r2)
STORAGE=local
# UPLOADS_DIR=

# NineRouter AI Gateway (chat + STT proxy)
NINEROUTER_BASE_URL=https://nine.hazz.biz.id/v1
NINEROUTER_API_KEY=
NINEROUTER_CHAT_MODEL=gpt-4o-mini
NINEROUTER_STT_MODEL=el/scribe_v2

# Speech-to-text provider (elevenlabs | proxy)
# Kosongkan = otomatis elevenlabs jika ELEVENLABS_API_KEY diisi, selain itu proxy
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
